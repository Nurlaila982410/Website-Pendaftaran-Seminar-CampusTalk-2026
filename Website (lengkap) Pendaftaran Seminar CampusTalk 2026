#FORM html + css#
<!DOCTYPE html>

<html>
<head>
    <title>Pendaftaran CampusTalk 2026</title>

</head>

<style>
    
    body {
        font-family: Cambria, serif;
        background-color: #eaf4ff;
        color: #333333;
        margin: 0;
        padding: 30px;}

    h1 {
        color: #003366;
        text-align: center;
        background-color: #b3d9ff;
        padding: 20px;
        border-radius: 10px;}

    .formulir {
        background-color: white;
        width: 60%;
        margin: 30px auto;
        padding: 30px;
        border-radius: 10px;}

    h2 {
        color: #003366;
        text-align: center;}

    .keterangan {
        font-size: 14px;
        color: #555555;}

    .bintang {
        color: red;}

    label {
        display: block;
        margin-top: 15px;
        font-weight: bold;}

    input, select, textarea {
        width: 100%;
        padding: 10px;
        margin-top: 5px;
        border: 1px solid #99c2e6;
        border-radius: 5px;
        box-sizing: border-box;
        font-family: Cambria, serif;}

    input:focus, select:focus, textarea:focus {
        outline: none;
        border: 2px solid #003366;}

    button {
        background-color: #003366;
        color: white;
        padding: 12px 20px;
        border: none;
        border-radius: 5px;
        margin-top: 20px;
        cursor: pointer;
        font-family: Cambria, serif;}

    button:hover {
        background-color: #0059b3;}

    .reset {
        background-color: #777777;}

    .kembali {
        text-align: center;
        margin-top: 25px;}

    .kembali a {
        color: #003366;
        text-decoration: none;
        font-weight: bold;}

    .kembali a:hover {
        color: #0059b3;
        text-decoration: underline;}

</style>

<body>


<h1>Pendaftaran Seminar CampusTalk 2026</h1>

<div class="formulir">

     <div id="formulir">

    <h2>Formulir Pendaftaran</h2>

    <p>Silakan isi data diri Anda dengan lengkap dan benar.</p>

    <p class="keterangan">
        <span class="bintang">*</span> Wajib diisi.
    </p>

    <form onsubmit="tampilData(event)">
    
        <label>Nama Lengkap <span class="bintang">*</span></label>
        <input type="text" name="nama" placeholder="Masukkan nama lengkap" required>

        <label>NIM <span class="bintang">*</span></label>
        <input type="text" name="nim" placeholder="Masukkan NIM" required>

        <label>Program Studi <span class="bintang">*</span></label>
        <input type="text" name="prodi" placeholder="Masukkan program studi" required>

        <label>Fakultas <span class="bintang">*</span></label>
        <input type="text" name="fakultas" placeholder="Masukkan fakultas" required>

        <label>Jenis Kelamin <span class="bintang">*</span></label>
        <select name="jenis_kelamin" required>
            <option value="">-- Pilih Jenis Kelamin --</option>
            <option value="Laki-laki">Laki-laki</option>
            <option value="Perempuan">Perempuan</option>
        </select>

        <label>Email <span class="bintang">*</span></label>
        <input type="email" name="email" placeholder="Masukkan email" required>

        <label>Nomor HP/WhatsApp <span class="bintang">*</span></label>
        <input type="tel" name="no_hp" placeholder="Masukkan nomor HP" required>

        <label>Alasan Mengikuti Seminar <span class="bintang">*</span></label>
        <textarea name="alasan" rows="4" placeholder="Tuliskan alasan Anda mengikuti seminar" required></textarea>

        <button type="submit">Daftar</button>
        <button type="reset" class="reset">Reset</button>

    </form>
    
    </div>

    <div id="hasil" style="display: none;">

    <h2>Data Pendaftaran</h2>

    <p>Nama: <span id="nama"></span></p>
    <p>NIM: <span id="nim"></span></p>
    <p>Program Studi: <span id="prodi"></span></p>
    <p>Fakultas: <span id="fakultas"></span></p>
    <p>Jenis Kelamin: <span id="jenis_kelamin"></span></p>
    <p>Email: <span id="email"></span></p>
    <p>Nomor HP: <span id="no_hp"></span></p>
    <p>Alasan: <span id="alasan"></span></p>

</div>

    <div class="kembali">
        <a href="index.html">← Kembali ke Beranda</a>
    </div>

</div>

<script src="form.js"></script>

</body>
</html>

#JAVA SCRIPT (folder baru "form.js")#function tampilData(event) {
    event.preventDefault();

    var data = new FormData(event.target);

    document.getElementById("nama").innerHTML = data.get("nama");
    document.getElementById("nim").innerHTML = data.get("nim");
    document.getElementById("prodi").innerHTML = data.get("prodi");
    document.getElementById("fakultas").innerHTML = data.get("fakultas");
    document.getElementById("jenis_kelamin").innerHTML = data.get("jenis_kelamin");
    document.getElementById("email").innerHTML = data.get("email");
    document.getElementById("no_hp").innerHTML = data.get("no_hp");
    document.getElementById("alasan").innerHTML = data.get("alasan");

    document.getElementById("formulir").style.display = "none";
    document.getElementById("hasil").style.display = "block";}
